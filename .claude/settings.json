{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Edit(/reference/**)",
      "Edit(/.gitmodules)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/scripts/reference.sh)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-reference-untouched.sh",
            "timeout": 30,
            "statusMessage": "Checking reference libraries are untouched"
          }
        ]
      }
    ]
  }
}
